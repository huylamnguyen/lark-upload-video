# Chép thành file tên ".env" nằm CẠNH lark_upload.py rồi điền. KHÔNG gửi file này qua chat.

# --- App Lark riêng của khách (Developer Console > app > Credentials) ---
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# larksuite (quốc tế) mặc định; tenant Feishu Trung Quốc: https://open.feishu.cn
LARK_DOMAIN=https://open.larksuite.com

# Thay cho APP_ID/SECRET khi không muốn để secret trên máy: n8n cấp token ngắn hạn
# TOKEN_URL=https://<n8n>/webhook/<khach>-cap-token-upload
# TOKEN_KEY=<khoá riêng của máy này>

# --- Base đích: dán link BẢNG từ trình duyệt (có ?table=tbl…), script tự tách token
LARK_BASE_LINK=https://xxx.larksuite.com/base/XXXXXXXXXXXXXXXX?table=tblXXXXXXXXXXXX
# hoặc điền thẳng:
# LARK_BASE_TOKEN=
# LARK_TABLE_ID=
# Cột kiểu "Tệp đính kèm" nhận video
COT_FILE=Video

# --- Ghép file vào dòng ---
# moi-file-mot-dong : mỗi file tạo 1 dòng, ghi tên file vào COT_TEN
# theo-ma           : tên file "MÃ_ghi chú.mp4" -> tìm dòng COT_MA = MÃ, gắn thêm vào dòng đó
CHE_DO_GHEP=moi-file-mot-dong
COT_TEN=Tên file
COT_MA=Mã

# --- Thư mục ---
THU_MUC_NGUON=D:\Video can gui
THU_MUC_DA_GUI_TEN=da-gui
CHUYEN_SAU_KHI_GUI=1
DUOI_FILE=.mp4,.mov,.m4v,.avi,.mkv,.webm,.3gp,.wmv

# Base bật quyền nâng cao mà upload báo lỗi quyền thì thử:
# LARK_EXTRA={"bitablePerm":{"tableId":"tblxxxxxxxxxxxxx","rev":1}}
